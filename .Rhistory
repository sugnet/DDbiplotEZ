PCA(group.aes = rownames(iris.int[[1]]$values)) |>
intervals (col = "grey50") |>
biplotEZ::axes (col = "grey75", tick.label = FALSE,
label.dir = "Hor", label.line=c(0.7, 0.1, 0.1, 1.45, 0.1, 0.1, 0.1, 0.7, 0.1, 0.1, 1.45)) |>
plot(type = "intervals", exp.factor=1)
